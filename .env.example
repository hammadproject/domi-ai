DATABASE_URL=            # Neon connection string (postgresql+psycopg://...)
REDIS_URL=               # Upstash or local (redis://localhost:6379/0)
RENTCAST_API_KEY=
GEMINI_API_KEY=          # Google AI Studio free key (LLM + embeddings)
LLM_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
LLM_DAILY_CALL_LIMIT=200  # app-level guard below the Gemini free quota
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
DEFAULT_INTEREST_RATE=6.75  # percent, editable estimate
PROPERTY_TAX_RATE_DEFAULT=1.8  # percent of price per year
HOME_INSURANCE_ANNUAL_DEFAULT=1800  # dollars per year
PMI_RATE_DEFAULT=0.7  # percent of loan per year
FRONT_END_DTI=0.28
BACK_END_DTI=0.36
RATE_LIMIT_PER_MINUTE=120       # general API, per IP
CHAT_RATE_LIMIT_PER_MINUTE=10   # /api/chat, per IP and per session
TRUST_FORWARDED_FOR=false       # true only behind a trusted proxy (Render)
CACHE_TTL_SECONDS=300
PARSE_CACHE_TTL_SECONDS=3600
LLM_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=20
CORS_ORIGINS=http://localhost:3000
